{
  "name": "new-admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:whatsapp-queue": "node --test tests/whatsappQueue.test.mjs",
    "test:whatsapp-queue:http": "node scripts/test-whatsapp-queue-http.mjs",
    "lint:whatsapp-queue": "eslint --no-config-lookup --config scripts/whatsapp-queue-eslint.config.mjs src/lib/server/whatsapp-queue-*.mjs src/app/api/admin/whatsapp-requests src/app/whatsapp-demandes/page.jsx scripts/test-whatsapp-queue-http.mjs tests/whatsappQueue.test.mjs",
    "test:whatsapp-integration:safety": "node --test tests/whatsappIntegrationSafety.test.mjs",
    "test:whatsapp-integration:http": "node scripts/test-whatsapp-integration-http.mjs",
    "lint:whatsapp-integration": "eslint --no-config-lookup --config scripts/whatsapp-queue-eslint.config.mjs scripts/whatsapp-integration-guard.mjs scripts/test-whatsapp-integration-http.mjs tests/whatsappIntegrationSafety.test.mjs",
    "test:whatsapp-rules:install": "npm --prefix tests/whatsapp-rules ci --include=dev --ignore-scripts --no-audit --no-fund",
    "test:whatsapp-rules:safety": "npm --prefix tests/whatsapp-rules run test:safety",
    "test:whatsapp-rules": "npm --prefix tests/whatsapp-rules test",
    "lint:whatsapp-rules": "eslint --no-config-lookup --config scripts/whatsapp-queue-eslint.config.mjs scripts/whatsapp-rules-guard.mjs tests/whatsapp-rules/tests/whatsappRulesSafety.test.mjs tests/whatsapp-rules/tests/whatsappClientRules.test.mjs",
    "test:whatsapp-full-app:safety": "node --test tests/whatsappFullAppSafety.test.mjs",
    "test:whatsapp-full-app:http": "node scripts/test-whatsapp-full-app-http.mjs",
    "lint:whatsapp-full-app": "eslint --no-config-lookup --config scripts/whatsapp-queue-eslint.config.mjs scripts/whatsapp-full-app-guard.mjs scripts/test-whatsapp-full-app-http.mjs tests/whatsappFullAppSafety.test.mjs"
  },
  "dependencies": {
    "@ckeditor/ckeditor5-build-classic": "^41.4.2",
    "@ckeditor/ckeditor5-react": "^11.0.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.9",
    "@mui/lab": "^7.0.1-beta.23",
    "@mui/material": "^7.3.9",
    "firebase": "^12.11.0",
    "html-react-parser": "^5.2.17",
    "moment": "^2.30.1",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-redux": "^9.2.0",
    "react-toastify": "^11.0.5",
    "redux": "^5.0.1",
    "redux-thunk": "^3.1.0",
    "thunk": "^0.0.1",
    "yet-another-react-lightbox": "^3.32.0",
    "firebase-admin": "^13.4.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "eslint": "^9",
    "eslint-config-next": "16.1.6"
  }
